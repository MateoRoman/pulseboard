# --- Secrets / entorno ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Claude Code ---
# Las skills de spec-kit en .claude/skills/ SÍ se versionan (son scaffold del proyecto).
# Solo se ignora el estado local, que es donde se guardan permisos y credenciales.
.claude/settings.local.json

# --- Estado de ejecución ---
# El almacén del foro es estado en tiempo de ejecución, no código fuente.
# Se crea al publicar el primer mensaje.
backend/data/messages.json
backend/data/messages.json.tmp

# --- Dependencias / builds ---
node_modules/
dist/
build/
.next/
out/
coverage/

# --- Java / Maven ---
target/
*.class
# El Maven Wrapper SÍ se versiona (no hay Maven global): mvnw, mvnw.cmd, .mvn/
!.mvn/wrapper/maven-wrapper.properties

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- OS / editor ---
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
